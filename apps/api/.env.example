# Copy to .env and restart the API. Only AGENTOS_LLM_API_KEY is required in development.

# --- LLM (required) ---------------------------------------------------------------------
# Gemini key from https://aistudio.google.com/apikey
AGENTOS_LLM_API_KEY=
# "<provider>:<model>" for LangChain's init_chat_model. Other providers need their
# langchain-* package installed (e.g. `uv add langchain-openai` for "openai:...").
AGENTOS_LLM_MODEL=google_genai:gemini-3.6-flash

# --- Vector database (optional) ---------------------------------------------------------
# Leave the URL empty to run Qdrant embedded, storing data under AGENTOS_QDRANT_PATH.
# Set it for a Qdrant server (http://localhost:6333) or Qdrant Cloud (plus the API key).
AGENTOS_QDRANT_URL=
AGENTOS_QDRANT_API_KEY=
AGENTOS_QDRANT_PATH=storage/qdrant

# --- Retrieval models (optional; run locally, downloaded on first use) ------------------
AGENTOS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AGENTOS_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
AGENTOS_MODEL_CACHE_DIR=~/.cache/agentlens/models

# --- App --------------------------------------------------------------------------------
AGENTOS_ENVIRONMENT=development
AGENTOS_CORS_ORIGINS=["http://localhost:3000"]
# Required outside development. Signs sessions and encrypts stored GitHub tokens;
# changing it signs everyone out and makes stored tokens unreadable.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTOS_SECRET_KEY=

# Defaults to a local SQLite file. For Postgres:
# AGENTOS_DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos

AGENTOS_STORAGE_DIR=storage
AGENTOS_MAX_DOCUMENT_MB=25
AGENTOS_MAX_CODEBASE_MB=100
AGENTOS_GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Per repository per run. A turn is one LLM request and may call several tools.
AGENTOS_GITHUB_MAX_TURNS=3
AGENTOS_GITHUB_MAX_TOOL_CALLS=10

# Run indexing on a Celery worker instead of inside the API. Needs Redis and a Qdrant
# server (embedded Qdrant cannot be shared between processes).
AGENTOS_USE_CELERY=false
AGENTOS_REDIS_URL=redis://localhost:6379/0
